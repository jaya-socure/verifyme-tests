{
  "name": "verifyme-tests",
  "version": "1.0.0",
  "description": "Standalone test suite for the VerifyMe API (runs against the live hosted API)",
  "scripts": {
    "test": "jest --verbose"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"],
    "testMatch": ["**/*.test.ts", "**/*.test.js"]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
